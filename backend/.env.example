# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
GEMINI_API_KEY=dan_key_cua_ban_vao_day
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Tài khoản quản trị đầu tiên (chỉ dùng ở LẦN CHẠY ĐẦU, khi chưa có tài khoản nào). Mật khẩu từ 8 ký tự trở lên.
# Sau khi đăng nhập admin.html, hãy đổi mật khẩu và tạo tài khoản cho nhân viên. Có thể xoá dòng ADMIN_PASSWORD sau lần đầu.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Các trang web được phép gọi backend, cách nhau bằng dấu phẩy
ALLOWED_ORIGINS=https://dthanhzy.github.io,http://localhost:5500,http://127.0.0.1:5500
# 1 = AI tra cứu web kỹ thuật sửa chữa khi chẩn đoán (mặc định bật); 0 = tắt
AI_WEB_SEARCH=1
# Thông báo đơn mới qua Telegram (tuỳ chọn): tạo bot bằng @BotFather, lấy chat id rồi điền 2 dòng dưới
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Thông tin nhận chuyển khoản để web hiện mã QR VietQR sau khi đặt hàng (tuỳ chọn, điền cả 2 dòng đầu mới có QR)
# BANK_CODE là mã ngân hàng theo VietQR, ví dụ VCB, MB, TCB, ACB, BIDV, VPB
BANK_CODE=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
# 0 = đã điền giá thật, ẩn thông báo "giá demo" trên web
DEMO_MODE=1
